<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fitness.admin.ai.mapper.KnowledgeBaseMapper">

    <resultMap id="exportResultMap" type="com.fitness.admin.ai.entity.KnowledgeBase">
        <id property="id" column="id"/>
        <result property="category" column="category"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="tags"
                column="tags"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="source" column="source"/>
        <result property="vectorStatus" column="vector_status"/>
        <result property="vectorId" column="vector_id"/>
        <result property="vectorModel" column="vector_model"/>
        <result property="vectorIndexedAt" column="vector_indexed_at"/>
        <result property="vectorError" column="vector_error"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectExportList" resultMap="exportResultMap">
        SELECT
            id, category, title, content, tags, source,
            vector_status, vector_id, vector_model, vector_indexed_at, vector_error,
            status, created_at, updated_at
        FROM knowledge_base
        ${ew.customSqlSegment}
    </select>

</mapper>